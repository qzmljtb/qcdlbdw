//角速度环
float YAW_ANGLESPEED_LOOP(float value)
{
    float SetValue = value;
    float ActualValue =imu963ra_gyro_z;
    float out = Positional_PID(&yaw_anglespeed_wheel, SetValue, ActualValue);

    int aaaa = abs(pidout_3f);

    if(aaaa > 6500) aaaa = 6500;//动态限幅,根据平衡环的输出改变转向环的限幅（否则两者加起来容易超过飞轮电机限幅，容易饱和）

    if(out > ( 7000 - aaaa))//6500
        out = ((float)(7000 - aaaa));
    if(out < -(7000 - aaaa))
        out = ((float)-(7000 - aaaa));

    return out;
}
