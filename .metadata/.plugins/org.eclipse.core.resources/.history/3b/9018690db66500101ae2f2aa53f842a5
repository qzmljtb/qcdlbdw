void Get_Use_Image(void)//压缩图像60*94
{
    uint8 mode = 0;
    uint16 i = 0, j = 0, row = 0, line = 0;
    if(mode == 0)
    {
        for (i = 40; i < 120; i ++)          //高 120 - 20 / 2  = 50，
        {
            for (j = 40; j <= 148 ; j ++)     //宽188 - 28 / 2  = 80，
            {
                use_image[row][line] = base_image[i][j]; //mt9v03x_image[i][j]
                line++;
            }
             line = 0;
             row++;
        }
    }
}

void er_zhi(void)
{
    //复制原始图像数组mt9v03x_image[0]给base_image[0]
    memcpy(base_image[0],mt9v03x_image[0],MT9V03X_IMAGE_SIZE);
    Get_Use_Image();
    uint16 i = 0, j = 0;
    camera_threshold=90;
    for( i = 0; i < 80; i++)
    {
        for( j = 0; j < 108; j++)
        {
            if(use_image[i][j] > camera_threshold)
            {
                erzhi_image[i][j] = 255;
            }
            else
            {
                erzhi_image[i][j] = 0;
            }
        }
    }
}

fy_d1 w[AREA_MAX];          // 连通域存储池
AreaFeature area[AREA_MAX]; // 特征计算结果


void seek_beacon(void)
{
    er_zhi();
    int16 i, j, y, x;
    int16 current_x1, current_x2;
    // 步骤1：初始化连通域内存
    for (i = 0; i < AREA_MAX; i++) {
        w[i].y1 = w[i].y2 = -1;
        w[i].work = w[i].end = w[i].type = 0;
        for (j = 0; j < 80; j++)
        {
            w[i].x1[j] = w[i].x2[j] = -1;
        }
        area[i].narea=0;
        area[i].alenght=0;
    }
    // 步骤2：逐行扫描连通域
    for (y = 0; y < 80; y++)
    {
        x = 0;
        while (x < 108)
        {
            if (erzhi_image[y][x] == 0)
            {
                x++;
                continue;
            }
            current_x1 = x;
            while (x < 108 && erzhi_image[y][x] != 0) x++;
            current_x2 = x - 1;

            // 步骤3：关联上下行连通域
            uint8 merged = 0;
            for (i = 0; i < AREA_MAX; i++)
            {
                if (w[i].work == 1 && w[i].end == 0)
                {
                    if (y > 0 && w[i].y2 == y - 1 &&
                        !(current_x2 < w[i].x1[y-1] || current_x1 > w[i].x2[y-1]))
                    {
                        w[i].x1[y] = current_x1;
                        w[i].x2[y] = current_x2;
                        w[i].y2 = y; // 更新终止行
                        merged = 1;
                        break;
                    }
                }
            }
            if (!merged)
            {
                for (i = 0; i < AREA_MAX; ++i)
                {
                    if (w[i].work == 0)
                    {
                        w[i].work = 1;
                        w[i].y1 = w[i].y2 = y;
                        w[i].x1[y] = current_x1;
                        w[i].x2[y] = current_x2;
                        break;
                    }
                }
            }
        }
        // 标记已完成采集的连通域（连续3行无数据）
        for (i = 0; i < AREA_MAX; ++i)
        {
            if (w[i].work == 1 && w[i].end == 0 &&(y - w[i].y2) > 3)
            {
                w[i].end = 1; // 结束采集
            }
        }
    }
    // 步骤4：计算几何特征
        for (i = 0; i < AREA_MAX; ++i)
        {
            if (w[i].work)
            {
                area[i].h = w[i].y2 - w[i].y1 + 1;
                area[i].y = (w[i].y1 + w[i].y2) / 2;
                int16 mid_row = area[i].y;
                area[i].x = (w[i].x1[mid_row] + w[i].x2[mid_row]) / 2;
                area[i].w = w[i].x2[mid_row] - w[i].x1[mid_row] + 1;

                for(int16 k=w[i].y1;k<w[i].y2;k++)
                {
                    for(int16 m=w[i].x1[mid_row];m<w[i].x2[mid_row];m++)
                    {
                        if (erzhi_image[k][m] != 0)
                        {
                           area[i].narea++;//白点++
                        }
                        if(( erzhi_image[k-1][m] && erzhi_image[k][m-1] && erzhi_image[k+1][m] && erzhi_image[k][m+1])== 0)
                        {
                            area[i].alenght++;//周长计算
                        }
                    }

                }
            }
        }

        // 步骤5：信标灯筛选逻辑
        for (i = 0; i < AREA_MAX; ++i)
        {
            if (w[i].work && !w[i].type)
            {
                if (w[i].y1 < 5) continue;

                area[i].alw = (float)area[i].w * 10 / area[i].h;//长宽比
                area[i].around = (4.0f * 3.1415927f * area[i].narea) / (area[i].alenght * area[i].alenght);//圆形度

                if (    (area[i].alw >= 0) && (area[i].alw <= 41)
//                        &&  0 < area[i].around && area[i].around <= 6                    //圆形度
//                        &&  0 <= area[i].narea && area[i].narea <= 850              //白点面积
//                        &&  0 < area[i].alenght && area[i].alenght <= 270
                    )
                {
                    w[i].type = 1;
                    break;
                }
            }
        }


        for (int i = 0; i <AREA_MAX; i++)
        {
            if (w[i].type == 1)
            {
                Beacon_x  =  area[i].x;
                Beacon_y  =  area[i].y;
                seek_flag = 1;
                eye_show();
                break;
            }
            else
            {
                Beacon_x = centerX;
                Beacon_y = 0;
                seek_flag = 0;
            }
        }
}

