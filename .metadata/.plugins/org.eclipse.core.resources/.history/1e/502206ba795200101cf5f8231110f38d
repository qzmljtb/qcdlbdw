void PID_Inc_Init(PID_IncTypeDef* sptr, float kp, float ki, float kd, float max_i, float max_out)
{
    sptr->Ek = 0;       //误差值
    sptr->Ek1 = 0;      //上次误差值
    sptr->Ek2 = 0;      //上上次误差值/误差累加
    sptr->Kp = kp;      //比例常数
    sptr->Ki = ki;      //积分常数
    sptr->Kd = kd;      //微分常数
    sptr->max_i = max_i;
    sptr->max_out = max_out;
}


