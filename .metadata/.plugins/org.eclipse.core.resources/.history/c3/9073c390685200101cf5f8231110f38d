}

// 牛顿迭代法求平方根
double newton_sqrt(double n)
{
    double x = n;
    double next_x;

    while (1)
    {
        next_x = 0.5 * (x + n / x);
        if (fabs(next_x - x) < 1e3 - 1)
        {
            break;
        }
        x = next_x;
    }
    return x;
}

